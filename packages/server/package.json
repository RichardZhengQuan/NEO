{
  "name": "@neo/server",
  "version": "0.1.0",
  "description": "NEO server: composition root, HTTP + WebSocket API, auth, notifications. Runs on-device or on your own server.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "neo-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@neo/core": "workspace:*",
    "@neo/memory": "workspace:*",
    "@neo/protocol": "workspace:*",
    "@neo/providers": "workspace:*",
    "@neo/storage": "workspace:*",
    "@neo/tools": "workspace:*",
    "@neo/tunnel": "workspace:*",
    "hono": "^4.13.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@neo/relay": "workspace:*",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2"
  }
}
