{
  "name": "@neo/providers",
  "version": "0.1.0",
  "description": "Model provider adapters for NEO: Anthropic, OpenAI & OpenAI-compatible (Ollama, LM Studio, vLLM, OpenRouter…), Gemini, and an offline mock.",
