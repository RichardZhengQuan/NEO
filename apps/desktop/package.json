{
  "name": "@neo/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NEO desktop app (Electron): runs the NEO server on your device and shows the web UI.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "icon:generate": "node scripts/generate-icon.mjs",
    "start": "electron .",
    "dev": "pnpm --filter @neo/web build && pnpm -r --filter @neo/desktop... build && electron .",
    "pack": "electron-builder --dir",
    "release:mac": "electron-builder --mac --publish always",
    "release:all": "electron-builder -mwl --publish always"
  },
  "dependencies": {
    "@neo/protocol": "workspace:*",
    "@neo/server": "workspace:*",
    "@neo/client": "workspace:*",
    "@neo/tunnel": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.18.0",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "dev.neo.app",
    "productName": "NEO",
    "files": [
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "protocols": [
        {
          "name": "NEO pairing",
          "schemes": [
            "neo"
          ],
          "role": "Viewer"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons"
    },
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "RichardZhengQuan",
      "repo": "NEO"
    }
  }
}
